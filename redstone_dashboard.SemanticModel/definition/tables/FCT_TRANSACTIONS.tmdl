table FCT_TRANSACTIONS
	lineageTag: a597f2bc-40e0-4283-9147-a70d40961c80

	measure 'Total Spend' = SUM(FCT_TRANSACTIONS[AMOUNT])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: a7e8c3b4-1234-4567-89ab-cdef01234567

	measure 'Average Transaction Value' = AVERAGE(FCT_TRANSACTIONS[AMOUNT])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: b8f9d4c5-2345-5678-9abc-def012345678

	measure 'Total Flagged Anomalies' = CALCULATE(COUNTROWS(FCT_TRANSACTIONS), FCT_TRANSACTIONS[AMOUNT] > 2000)
