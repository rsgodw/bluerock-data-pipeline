model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DIM_ACCOUNTS","FCT_TRANSACTIONS","DIM_MEMBERS","DIM_DATE"]

annotation PBI_ProTooling = ["DevMode"]

ref table DIM_ACCOUNTS
ref table FCT_TRANSACTIONS
ref table DIM_MEMBERS
ref table DIM_DATE

ref cultureInfo en-US

